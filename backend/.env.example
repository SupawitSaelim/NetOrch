# NetOrch Backend

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Security
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# System Mode: "dc" or "wan"
SYSTEM_MODE=dc

# FRRouting
FRR_ENABLED=false
FRR_VTYSH_PATH=/usr/bin/vtysh

# Ryu SDN Controller
RYU_ENABLED=false
RYU_URL=http://localhost:8080

# Open vSwitch
OVS_ENABLED=false
OVS_VSCTL_PATH=/usr/bin/ovs-vsctl
