# NetOrch Backend Configuration
# Copy this file to .env and customize for your environment

# ── API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security (MUST change for production) ────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MIN_PASSWORD_LENGTH=8

# ── CORS (comma-separated origins, or "*" for all) ──────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── System Mode ("dc" or "wan") ─────────────────────────────────
SYSTEM_MODE=dc

# ── VM Connection ────────────────────────────────────────────────
VM_HOST=192.168.64.3
VM_USER=root
VM_SSH_KEY=~/.ssh/id_ed25519

# ── FRRouting ────────────────────────────────────────────────────
FRR_ENABLED=false
FRR_VTYSH_PATH=/usr/bin/vtysh
FRR_DEFAULT_ASN=65001

# ── SDN Controller / REST API ───────────────────────────────────
RYU_ENABLED=false
RYU_URL=http://192.168.64.3:8080

# ── Open vSwitch ─────────────────────────────────────────────────
OVS_ENABLED=false
OVS_VSCTL_PATH=/usr/bin/ovs-vsctl

# ── Operational Tuning ──────────────────────────────────────────
CACHE_STATS_TTL=10.0
CACHE_TOPOLOGY_TTL=30.0
CACHE_HEALTH_TTL=15.0
WS_BROADCAST_INTERVAL=5.0
SSH_CONTROL_PERSIST=300
SSH_TIMEOUT=15
AUDIT_MAX_ENTRIES=500
